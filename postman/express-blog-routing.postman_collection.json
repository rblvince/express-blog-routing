      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/posts/abc"
      }
    },
    {
      "name": "GET endpoint inesistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/endpoint-inesistente"
      }
